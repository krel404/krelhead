# Discord Developer Portal > Application > Bot. Keep this secret.
DISCORD_TOKEN=
# Discord Developer Portal > Application > General Information
DISCORD_APPLICATION_ID=
# Recommended during development: registers commands instantly in one server.
# Leave empty to register global commands.
DISCORD_GUILD_ID=
# Persistent settings directory; mount this when deploying in a container.
DATA_DIR=./data

# OpenAI Responses API. Leave the key empty for slash-command lookups only.
# Conversational mode requires Message Content and Server Members intents in Discord.
OPENAI_API_KEY=
# Configurable; must support Responses function tools, reasoning, and web_search.
# Astra model IDs are blocked by the application to prevent accidental high costs.
OPENAI_MODEL=gpt-6-luna
# Dedicated web research model. Chat, lookups, and final formatting stay on Luna.
OPENAI_RESEARCH_MODEL=gpt-6.1-sol

# Optional authenticated snapshot uploader. Discord file imports work without this.
# Bind to loopback behind an HTTPS reverse proxy for remote players.
# SNAPSHOT_PORT=8787
# SNAPSHOT_HOST=127.0.0.1
# SNAPSHOT_PUBLIC_URL=https://tome.example.com/v1/snapshots
